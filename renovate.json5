{
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days",
    "automerge": false,
    "labels": [
      "security"
    ]
  },
  "nix": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "timezone": "Asia/Tokyo",
    "schedule": ["before 6am on monday"],
    "updateNotScheduled": false,
    "rebaseWhen": "conflicted",
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["before 6am on monday"]
    },
    "prBodyNotes": [
      "Nix updates wait 3 days from this PR revision's first CI run before building. New commits restart the wait. Nix CI must pass before merging."
    ]
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "automerge": false
    }
  ]
}
