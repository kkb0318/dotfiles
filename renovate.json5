{
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days",
    "automerge": false,
    "labels": [
      "security"
    ]
  },
  "extends": [
    "github>aquaproj/aqua-renovate-config#2.7.5"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}
